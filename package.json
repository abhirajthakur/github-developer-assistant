{
  "name": "github-developer-assistant",
  "version": "1.0.0",
  "license": "ISC",
  "author": "Abhiraj Thakur",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/http.ts",
    "dev:stdio": "tsx watch src/index.ts",
    "start": "node dist/http.js",
    "start:stdio": "node dist/index.js",
    "build": "tsc -b",
    "clean": "rm -rf dist/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "inspect": "pnpm exec mcp-inspector tsx src/index.ts",
    "inspect:http": "pnpm exec mcp-inspector tsx src/http.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.10.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2"
}
